# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# Obsidian vault is linked from outside this repo (Obsidian Sync).
# Never commit notes, attachments, or plugin state.
vault/

# Common Obsidian junk, in case a vault is placed somewhere else.
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/cache/
**/.obsidian/plugins/**/data.json
**/.trash/

# Generated from the linked vault at dev/build time.
src/content/docs/notes/
src/content/docs/en/notes/
src/assets/notes/
src/content/docs/posts/
src/content/docs/en/posts/
src/assets/posts/
public/notes/
public/posts/
